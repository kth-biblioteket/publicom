# Testdator (t ex VM i UTM) mot ref-miljön. Påverkar inte riktiga bokningar.
PROFILE=guest-login
RESOURCE_ID=1
COMPUTER_NAME="KTH Library TEST (ref)"
API_URL=https://apps-ref.lib.kth.se/almatools/almalogin
RESERVATION_API_UPDATE_URL=https://api-ref.lib.kth.se/bookingsystem/v1/entry/updateendtime/guestcomputers/
RESERVATION_API_CREATE_URL=https://api-ref.lib.kth.se/bookingsystem/v1/entry/create/guestcomputers/
RESERVATION_API_URL=https://api-ref.lib.kth.se/bookingsystem/v1/entry/validate/guestcomputers/
RESERVATION_API_CURRENT_RES_URL=https://api-ref.lib.kth.se/bookingsystem/v1/entry/check/guestcomputers/
BOOKING_SYSTEM_URL=https://apps-ref.lib.kth.se/guestcomputers
REGISTER_ACCOUNT_URL="https://apps-ref.lib.kth.se/formtools/api/v1/kthbform?formid=libraryaccount_kiosk&lang=sv&kiosk=true"
# Mjukvaru-WebGL: test-VM:er i UTM har ingen GPU som Chromium kan använda (behövs t ex för Wagnerguide-kartan)
CHROMIUM_FLAGS="--enable-unsafe-swiftshader"
# QEMU:s portvidarebefordran i UTM (test-VM) kommer från 10.0.2.2
SSH_ALLOW_FROM="130.237.0.0/16,10.0.2.0/24"
# publicomtools i Docker på Macen (docker-compose-dev.yml), nås från VM:en via QEMU
HEARTBEAT_URL=http://10.0.2.2:3002/api/heartbeat
LOGIN_UI=web
PUBLICOMTOOLS_URL=http://10.0.2.2:3002
