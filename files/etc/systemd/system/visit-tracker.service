[Unit]
Description=Besök för användningsstatistiken (publicomtools)
After=guest.service
ConditionKernelCommandLine=!publicom.maintenance
ConditionPathExists=/usr/bin/python3

[Service]
# Läser /dev/input (riktiga tangent-, mus- och pekhändelser), därför root
ExecStart=/usr/bin/python3 /usr/local/bin/visit_tracker.py
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target
