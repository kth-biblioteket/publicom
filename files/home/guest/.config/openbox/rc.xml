<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc" xmlns:xi="http://www.w3.org/2001/XInclude">
  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
  </desktops>
  <applications>
    <application type="normal">
      <decor>no</decor>
      <focus>yes</focus>
    </application>
    <!-- Dialoger från zenity (t ex bekräftelsen vid Logout) ska alltid hamna mitt på skärmen.
         Matchar instansnamnet, eftersom klassen är "Zenity" i zenity 3 (20.04) men "zenity" i zenity 4 (24.04). -->
    <application name="zenity">
      <position force="yes">
        <x>center</x>
        <y>center</y>
      </position>
      <focus>yes</focus>
      <layer>above</layer>
    </application>
  </applications>
</openbox_config>
