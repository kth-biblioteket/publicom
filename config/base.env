# Gemensamma värden för alla datorer.
# Profilen (config/profiles) och datorn (config/hosts) skriver över värden härifrån.
# Kör tools/build-configs.sh efter ändring för att generera .config_<dator>.

# Branch som datorerna hämtar skript, config och policy från
PUBLICOM_BRANCH=stable

RESOURCE_ID=x
LOGINTYPE=password
API_URL=https://apps.lib.kth.se/almatools/almalogin
RESERVATION_API_UPDATE_URL=https://api.lib.kth.se/bookingsystem/v1/entry/updateendtime/guestcomputers/
RESERVATION_API_CREATE_URL=https://api.lib.kth.se/bookingsystem/v1/entry/create/guestcomputers/
RESERVATION_API_URL=https://api.lib.kth.se/bookingsystem/v1/entry/validate/guestcomputers/
RESERVATION_API_CURRENT_RES_URL=https://api.lib.kth.se/bookingsystem/v1/entry/check/guestcomputers/
BOOKING_SYSTEM_URL=https://apps.lib.kth.se/guestcomputers
BOOKING_TYPE=dropin
DEFAULT_BOOKING_TIME=2
REGISTER_ACCOUNT_URL=https://apps.lib.kth.se/formtools/api/v1/kthbform?formid=libraryaccount_kiosk&lang=sv&kiosk=true
EXTERNAL_URL_TIMEOUT=30000
CLEAR_FIELDS_TIMEOUT=30000
ELECTRON_DEV_TOOLS=false
ALMA_LOGIN=false
PRINTER=false
COMPUTER_TYPE=searchcomputer
SESSION_IDLE=5
SCREENSAVER=true
SCREENSAVER_IDLE=00:30:00
POLICY_FILE="policies_search.json"
KIOSK=
BLACK_LIST="*,google.com"

# Källor som får ansluta med SSH (brandväggen, sätts av install.sh)
SSH_ALLOW_FROM="130.237.0.0/16"

# Statussidan: datorn skickar status hit var 5:e minut (heartbeat.timer).
# Kräver HEARTBEAT_TOKEN i .secrets, annars skickas inget.
HEARTBEAT_URL=https://apps.lib.kth.se/publicomtools/api/heartbeat
