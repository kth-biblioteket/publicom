// Automatiska uppdateringar (Ubuntus unattended-upgrades): bara säkerhetsuppdateringar,
// enligt standard i 50unattended-upgrades. Tider styrs av apt-daily*.timer (se publicom.conf).
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Download-Upgradeable-Packages "1";
APT::Periodic::AutocleanInterval "7";
APT::Periodic::Unattended-Upgrade "1";
